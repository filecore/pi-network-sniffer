# pi-network-sniffer config -- copy to /opt/pi-network-sniffer/etc/config.env
# on the Pi (NOT committed to git).
#
# All values are optional; defaults are baked into the scripts.

# --- Remote server (where uploads go) ---------------------------------------------
# the remote server's WireGuard tunnel address. Reachable from the Pi once wg0 is up.
REMOTE_WG_IP=10.8.0.9
REMOTE_SSH_USER=deploy
# Remote path (relative to ${REMOTE_SSH_USER} home) for uploads.
REMOTE_UPLOADS_DIR=pi-network-sniffer-uploads
# Remote path (relative to ${REMOTE_SSH_USER} home) holding the pentest suite.
REMOTE_PENTEST_DIR=scripts/pentest

# --- SSH ------------------------------------------------------------------
# Path to the SSH private key the systemd unit uses (runs as root).
SSH_KEY=/root/.ssh/id_ed25519

# --- ntfy ----------------------------------------------------------------
NTFY_URL=https://ntfy.yourdomain.tld
NTFY_TOPIC=pi-network-sniffer

# --- Behaviour -----------------------------------------------------------
# Local run-dir retention before pruning.
KEEP_RUNS=10
# Seconds to wait for "network ready" before giving up.
NETWORK_WAIT_SECS=300
